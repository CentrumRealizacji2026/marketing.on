# Baza danych — na produkcji connection string z Neon (Vercel Marketplace),
# lokalnie zwykły Postgres.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/zycie"

# Klucz do Claude API — mentor / trener / kierownik projektów.
# https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Kto może założyć konto. Pusta wartość = rejestracja zamknięta po pierwszym koncie.
# Lista adresów po przecinku.
ALLOWED_SIGNUP_EMAILS=""

# Sekret chroniący endpointy cronów: rekomendacje mentora (Vercel Cron)
# i przypomnienia push (GitHub Actions co 15 minut).
CRON_SECRET=""

# Powiadomienia push — klucze VAPID (wygeneruj: npx web-push generate-vapid-keys).
# Bez nich strona Ustawienia → Powiadomienia pokazuje instrukcję zamiast włącznika.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:twoj-adres@example.com"
